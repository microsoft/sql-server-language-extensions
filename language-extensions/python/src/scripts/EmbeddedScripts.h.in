// @File: EmbeddedScripts.h.in
//
// Purpose:
//  CMake template for the generated EmbeddedScripts.h. The Python helpers under
//  language-extensions/python/src/scripts are authored as real .py files - so they can be
//  linted, syntax-checked at build time and diffed as Python - then embedded here verbatim.
//  Nothing is shipped alongside the extension; the scripts live inside the binary.
//
//  Each script is carried as a raw string literal, so a script must never contain the
//  closing delimiter )PY" nor an @-delimited token that configure_file would substitute.
//
//  Do not edit the generated EmbeddedScripts.h - edit the .py file or this template.
//
//*************************************************************************************************
#pragma once

namespace EmbeddedScripts
{
	// Generated from language-extensions/python/src/scripts/normalize_zip.py
	//
	constexpr char NormalizeZip[] = R"PY(
@NORMALIZE_ZIP_PY@
)PY";
}
